# Phase 5 part A (docs/phase5-design.md §2-§4): the SystemVerilog array, one
# Verilated model per (R, C) variant, the testbench, lint and the hand-trace
# and quick correlation tests. Included from the top-level CMakeLists.txt.

find_package(verilator REQUIRED HINTS $ENV{VERILATOR_ROOT} /usr/share/verilator)
find_program(APM_VERILATOR_EXE verilator REQUIRED)

# Every (R, C) the correlation program set uses (design note §4).
set(APM_RTL_VARIANTS 2x3 2x2 1x4 2x4 4x4 1x16 2x16 4x16 8x16 1x32 2x32 4x32 8x32 16x16)
set(APM_RTL_SOURCES ${CMAKE_SOURCE_DIR}/rtl/os_array.sv ${CMAKE_SOURCE_DIR}/rtl/os_cell.sv)

add_executable(os_array_tb tb/os_array_tb.cpp)
# Verilator-generated code is not held to the project's -Werror warning set;
# keep only the floating-point rule (and the sanitizers in the asan preset).
set_property(TARGET os_array_tb PROPERTY COMPILE_OPTIONS -ffp-contract=off)
if(APM_SANITIZE)
  target_compile_options(os_array_tb PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all
                                             -fno-omit-frame-pointer)
endif()
target_link_libraries(os_array_tb PRIVATE apm_core)

set(apm_rtl_includes "")
set(apm_rtl_list "")
foreach(v IN LISTS APM_RTL_VARIANTS)
  string(REPLACE "x" ";" rc "${v}")
  list(GET rc 0 r)
  list(GET rc 1 c)
  verilate(os_array_tb SOURCES ${APM_RTL_SOURCES} TOP_MODULE os_array PREFIX Vos_${v}
           VERILATOR_ARGS -GR=${r} -GC=${c})
  string(APPEND apm_rtl_includes "#include \"Vos_${v}.h\"\n")
  string(APPEND apm_rtl_list " X(${r}, ${c}, Vos_${v})")
endforeach()
file(WRITE ${CMAKE_BINARY_DIR}/rtl_gen/rtl_variants.h
     "// Generated by cmake/rtl.cmake: the Verilated os_array variants.\n#pragma once\n"
     "${apm_rtl_includes}#define APM_RTL_VARIANTS(X)${apm_rtl_list}\n")
target_include_directories(os_array_tb PRIVATE ${CMAKE_BINARY_DIR}/rtl_gen)

# Lint (exit criterion 1): clean under -Wall, no waivers, at three shapes.
foreach(v 1x4 4x16 16x16)
  string(REPLACE "x" ";" rc "${v}")
  list(GET rc 0 r)
  list(GET rc 1 c)
  add_test(NAME rtl.lint_${v}
           COMMAND ${APM_VERILATOR_EXE} --lint-only -Wall -GR=${r} -GC=${c} --top-module os_array ${APM_RTL_SOURCES})
endforeach()
# Hand-written traces: the RTL and contract_trace must both reproduce them.
foreach(h ht1 ht2)
  add_test(NAME rtl.${h}
           COMMAND os_array_tb ${CMAKE_SOURCE_DIR}/tests/rtl/${h}.sched
                   --expect-trace ${CMAKE_SOURCE_DIR}/tests/rtl/${h}.trace)
endforeach()
# Quick correlation: Phase 2 directed schedules plus a few random PE and grid cases.
add_test(NAME rtl.correlate_quick
         COMMAND ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/python/correlate.py --quick
                 --tools $<TARGET_FILE_DIR:os_array_tb>)
set_tests_properties(rtl.lint_1x4 rtl.lint_4x16 rtl.lint_16x16 rtl.ht1 rtl.ht2 rtl.correlate_quick
                     PROPERTIES LABELS rtl ENVIRONMENT "SYSTEMC_DISABLE_COPYRIGHT_MESSAGE=1")
